---
// The page shell shared by every page (formerly _layouts/default.html).
//
// The theme's JavaScript (public/js/index-min.js) loads internal links over
// AJAX: it fetches the next page and swaps in its `.page__content` element, so
// anything a page needs must live inside that element. Pages whose inline
// scripts must run set `fullPageLoad` to force a normal reload instead.
import '../styles/style.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title; " - Aerospace Controls Laboratory" is appended. Omit on the home page. */
  title?: string;
  description?: string | null;
  image?: string | null;
  /** Send visitors straight to this URL instead (e.g. a project hosted elsewhere). */
  redirectTo?: string | null;
  fullPageLoad?: boolean;
  /** This page's URL as the theme JS sees it (highlights links to it); defaults to the request path. */
  pageUrl?: string;
}

const { title, description = site.description, image, redirectTo, fullPageLoad = false, pageUrl = Astro.url.pathname } = Astro.props;
const fullTitle = title ? `${title} - ${site.title}` : `${site.title} - ${site.tagline}`;
const ogImage = new URL(image || site.defaultImage, site.url).href;
const fav = site.faviconFolder;
const loaderSvg =
  '<svg width="120" height="30" viewBox="0 0 120 30" xmlns="http://www.w3.org/2000/svg"><circle cx="15" cy="15" r="15"><animate attributeName="r" from="15" to="15" begin="0s" dur="0.8s" values="15;9;15" calcMode="linear" repeatCount="indefinite" /><animate attributeName="fill-opacity" from="1" to="1" begin="0s" dur="0.8s" values="1;.5;1" calcMode="linear" repeatCount="indefinite" /></circle><circle cx="60" cy="15" r="9" fill-opacity="0.3"><animate attributeName="r" from="9" to="9" begin="0s" dur="0.8s" values="9;15;9" calcMode="linear" repeatCount="indefinite" /><animate attributeName="fill-opacity" from="0.5" to="0.5" begin="0s" dur="0.8s" values=".5;1;.5" calcMode="linear" repeatCount="indefinite" /></circle><circle cx="105" cy="15" r="15"><animate attributeName="r" from="15" to="15" begin="0s" dur="0.8s" values="15;9;15" calcMode="linear" repeatCount="indefinite" /><animate attributeName="fill-opacity" from="1" to="1" begin="0s" dur="0.8s" values="1;.5;1" calcMode="linear" repeatCount="indefinite" /></circle></svg>';
---

<!doctype html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

    {
      redirectTo && (
        <>
          <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
          <link rel="canonical" href={redirectTo} />
          <script is:inline define:vars={{ redirectTo }}>
            window.location.replace(redirectTo);
          </script>
        </>
      )
    }

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href={`${fav}/apple-touch-icon.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${fav}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${fav}/favicon-16x16.png`} />
    <link rel="manifest" href={`${fav}/site.webmanifest`} />
    <link rel="mask-icon" href={`${fav}/safari-pinned-tab.svg`} color="#5bbad5" />
    <link rel="shortcut icon" href={`${fav}/favicon.ico`} />
    <meta name="msapplication-TileColor" content="#ffc40d" />
    <meta name="msapplication-config" content={`${fav}/browserconfig.xml`} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Page Info -->
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? ''} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description ?? ''} />
    <meta name="twitter:image:src" content={ogImage} />

    <!-- Facebook OpenGraph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? ''} />
    <meta property="og:image" content={ogImage} />

    <!-- Font Embed Code -->
    <link href={site.fontEmbed} rel="stylesheet" />

    <!-- Styles -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Icons -->
    <script
      is:inline
      defer
      src="https://use.fontawesome.com/releases/v5.1.1/js/solid.js"
      integrity="sha384-GXi56ipjsBwAe6v5X4xSrVNXGOmpdJYZEEh/0/GqJ3JTHsfDsF8v0YQvZCJYAiGu"
      crossorigin="anonymous"></script>
    <script
      is:inline
      defer
      src="https://use.fontawesome.com/releases/v5.1.1/js/brands.js"
      integrity="sha384-0inRy4HkP0hJ038ZyfQ4vLl+F4POKbqnaUB6ewmU4dWP0ki8Q27A0VFiVRIpscvL"
      crossorigin="anonymous"></script>
    <script
      is:inline
      defer
      src="https://use.fontawesome.com/releases/v5.1.1/js/fontawesome.js"
      integrity="sha384-NY6PHjYLP2f+gL3uaVfqUZImmw71ArL9+Roi9o+I4+RBqArA2CfW1sJ1wkABFfPe"
      crossorigin="anonymous"></script>

    {
      site.analyticsId && (
        <>
          <!-- Global site tag (gtag.js) - Google Analytics -->
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`} />
          <script is:inline define:vars={{ id: site.analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
  </head>

  <body class="loading ajax-loading" data-site-url="" data-page-url={pageUrl}>
    <Header />

    <div class="loader" set:html={loaderSvg} />

    <div class="page-loader"></div>

    <div class="page">
      <div
        class="page__content"
        data-page-title={fullTitle}
        data-redirect-to={redirectTo || undefined}
        data-full-page-load={fullPageLoad || undefined}
      >
        <slot />
      </div>
    </div>

    <Footer />

    <!-- Javascript Assets -->
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script is:inline src="/js/index-min.js"></script>

    <script is:inline>
      (function () {
        function checkRedirect() {
          var el = document.querySelector('.page__content[data-redirect-to]');
          if (el) window.location.replace(el.getAttribute('data-redirect-to'));
        }
        // AJAX-loaded content doesn't run its inline scripts, so pages that need them
        // (`fullPageLoad`) are reloaded as a full page
        function checkFullPageLoad() {
          if (document.querySelector('.page .page__content[data-full-page-load]')) window.location.reload();
        }
        // Watch for the AJAX loader swapping in a new .page__content
        var observer = new MutationObserver(function () {
          checkRedirect();
          checkFullPageLoad();
        });
        var page = document.querySelector('.page');
        if (page) observer.observe(page, { childList: true });
      })();
    </script>
  </body>
</html>
